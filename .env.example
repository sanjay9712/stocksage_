# StockSage backend configuration.
# Copy to `backend/.env` (loaded by pydantic-settings, all vars prefixed APP_).
# Every value below is the built-in default — override only what you need.

# --- Auth / tokens -----------------------------------------------------------
# Shared bearer token for the API (frontend uses the JWT issued at login).
APP_AUTH_TOKEN=dev-secret-change-me
APP_JWT_SECRET=dev-jwt-secret-change-me
APP_JWT_EXPIRE_DAYS=7

# --- Data provider -----------------------------------------------------------
# yfinance (default, free) | fyers (needs the keys below)
APP_DATA_PROVIDER=yfinance
APP_FYERS_APP_ID=
APP_FYERS_SECRET=
APP_FYERS_ACCESS_TOKEN=
# IND Money account JWT (one-time DevTools capture; empty = not used)
APP_IND_MONEY_TOKEN=

# --- Market / universe -------------------------------------------------------
APP_TZ=Asia/Kolkata
APP_UNIVERSE=nifty50
APP_OR_START=09:15
APP_OR_END=09:30
APP_INTRADAY_INTERVAL=5m
APP_VOLUME_RATIO_MIN=1.2
APP_NO_TRADE_GAP_PCT=1.0
APP_NO_TRADE_BREADTH_PCT=40.0

# --- Live market engine ------------------------------------------------------
# Seconds between NSE index/status polls (market open)
APP_LIVE_INDEX_POLL=2.0
# Seconds between stock-quote polls (market open)
APP_LIVE_WATCHLIST_POLL=5.0
# Comma-separated symbols to poll live (empty = indices only)
APP_LIVE_WATCHLIST=
# Seconds between polls when the market is closed
APP_LIVE_IDLE_POLL=30.0

# --- Broker ------------------------------------------------------------------
# mock (default) | fyers
APP_BROKER_PROVIDER=mock

# --- Web / server ------------------------------------------------------------
APP_DB_PATH=data/trading.db
APP_CORS_ORIGINS=http://localhost:3000

# --- Email digests (optional — digests are stored in the app without SMTP) ---
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USER=
APP_SMTP_PASSWORD=
APP_DIGEST_FROM_EMAIL=
# Hour (IST) the daily market digest is sent, 0-23 (16 = 4 PM IST)
APP_DIGEST_SEND_HOUR=16
